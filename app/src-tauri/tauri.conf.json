{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Esport Manager",
  "version": "0.0.1",
  "identifier": "com.esportmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Esport Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 760
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "../../data/seed/world.sqlite": "world.sqlite" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
